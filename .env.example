# ---------------------------------------------------------------------------
# Copy this file to `.env` before running `docker compose up --build`.
#   cp .env.example .env
# The values below are safe defaults for local development ONLY.
# ---------------------------------------------------------------------------

# Mongo credentials used to initialise the `mongo` container.
MONGO_INITDB_ROOT_USERNAME=jobportal
MONGO_INITDB_ROOT_PASSWORD=jobportal_dev_password
MONGO_DB_NAME=job_portal

# Connection string used by the Next.js app.
# Host `mongo` is the compose service name; use `localhost` when running the
# app outside Docker against a local mongod.
MONGODB_URI=mongodb://jobportal:jobportal_dev_password@mongo:27017/job_portal?authSource=admin

# Secret used to sign session JWTs. MUST be at least 32 characters.
# Generate a real one with:  openssl rand -base64 48
JWT_SECRET=dev_only_change_me_min_32_chars_long_secret_value
# Session lifetime in seconds (default 7 days).
JWT_EXPIRES_IN_SECONDS=604800

# Where uploaded resumes are written. Inside Docker this path is a named volume.
UPLOADS_DIR=/app/uploads
# Maximum accepted resume size in bytes (default 5 MB).
MAX_RESUME_BYTES=5242880

# Seed fixed HR accounts, a demo candidate and sample jobs on server start.
SEED_ON_BOOT=true

# Passwords for the seeded demo accounts (documented in the README).
SEED_HR_PASSWORD=Hr@Passw0rd123
SEED_CANDIDATE_PASSWORD=Cand@Passw0rd123
